#!/usr/bin/env python3
"""Surface paint visualiser: paints the REAL car mesh (body only - no glass / tyres / lamps)."""
import glob
import os
import sys
from collections import deque

import numpy as np

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from paint_swath import PaintState, densify, quat_to_R  # noqa: E402

LIGHT = np.array([0.35, -0.45, 0.82])
LIGHT = LIGHT / np.linalg.norm(LIGHT)
E = np.eye(3)
EXCLUDE_WORDS = 'glass,window,windshield,windscreen,tire,tyre,wheel,rim,lamp,light,mirror,wiper,plate,rubber,chrome,grill,lens'


def find_mesh(explicit):
    if explicit and os.path.isfile(explicit):
        return explicit
    try:
        from ament_index_python.packages import get_package_share_directory
        p = os.path.join(get_package_share_directory('painting_cell_description'),
                         'meshes', 'car', 'automotive_painting_car.dae')
        if os.path.isfile(p):
            return p
    except Exception:
        pass
    hits = glob.glob(os.path.expanduser('~/automotive_painting_ws/src/**/automotive_painting_car.dae'),
                     recursive=True)
    return hits[0] if hits else None


def _material_info(g):
    name, alpha, lum = '', 1.0, 1.0
    try:
        mat = g.visual.material
        name = str(getattr(mat, 'name', '') or '')
        c = getattr(mat, 'main_color', None)
        if c is None:
            c = getattr(mat, 'diffuse', None)
        if c is not None:
            c = np.asarray(c, float).ravel()
            if c.max() > 1.5:
                c = c / 255.0
            lum = float(c[:3].mean())
            alpha = float(c[3]) if len(c) > 3 else 1.0
    except Exception:
        pass
    return name, alpha, lum


def load_car(path, ref_pts, max_edge=0.04, exclude_words=EXCLUDE_WORDS, log=print):
    import trimesh
    words = [w.strip().lower() for w in exclude_words.split(',') if w.strip()]
    scene = trimesh.load(path, process=False)
    parts = []
    if isinstance(scene, trimesh.Scene):
        for node in scene.graph.nodes_geometry:
            T, gname = scene.graph[node]
            g = scene.geometry[gname].copy()
            g.apply_transform(T)
            parts.append((str(gname), g))
    else:
        parts.append(('mesh', scene))
    Vs, Fs, EX, off = [], [], [], 0
    log('car mesh parts (name | material | triangles | status):')
    for gname, g in parts:
        mname, alpha, lum = _material_info(g)
        key = (gname + ' ' + mname).lower()
        bad = any(w in key for w in words) or alpha < 0.95
        why = 'EXCLUDED' if bad else 'painted'
        log('   %-28s | %-22s | %6d | %s' % (gname[:28], mname[:22], len(g.faces), why))
        Vs.append(np.asarray(g.vertices, float))
        Fs.append(np.asarray(g.faces, int) + off)
        EX.append(np.full(len(g.faces), bad))
        off += len(g.vertices)
    V0, F, EX = np.vstack(Vs), np.vstack(Fs), np.concatenate(EX)
    rots = {'as-is': np.eye(3), 'Y-up to Z-up': np.array([[1, 0, 0], [0, 0, -1], [0, 1, 0]], float)}
    c_ref = (ref_pts.min(0) + ref_pts.max(0)) / 2
    best = None
    for rn, Rm in rots.items():
        for sc in (1.0, 0.001, 0.01, 0.0254):
            V = (V0 @ Rm.T) * sc
            lo, hi = V.min(0) - 0.3, V.max(0) + 0.3
            inside = np.all((ref_pts >= lo) & (ref_pts <= hi), axis=1).mean()
            score = inside * 10 - np.linalg.norm((V.min(0) + V.max(0)) / 2 - c_ref)
            if best is None or score > best[0]:
                best = (score, rn, sc, V, inside)
    _, rn, sc, V, inside = best
    log("orientation=%s, scale=%g, %.0f%% of planned path inside car bounds; bounds min=%s max=%s"
        % (rn, sc, 100 * inside, np.round(V.min(0), 2), np.round(V.max(0), 2)))
    try:
        from trimesh.remesh import subdivide_to_size
        V, F, idx = subdivide_to_size(V, F, max_edge=max_edge, max_iter=12, return_index=True)
        EX = EX[idx]
        log("mesh refined to %d triangles (max edge %.0f cm); %d excluded" % (len(F), max_edge * 100, EX.sum()))
    except Exception as e:
        log("mesh refinement skipped: %s" % e)
    return np.asarray(V, float), np.asarray(F, int), np.asarray(EX, bool), inside


class SurfacePainter:
    def __init__(self, V, F, radius=0.30, excluded=None):
        self.V, self.F = V, F
        T = V[F]
        self.C = T.mean(axis=1)
        n = np.cross(T[:, 1] - T[:, 0], T[:, 2] - T[:, 0])
        a = np.linalg.norm(n, axis=1)
        a[a == 0] = 1e-12
        self.N = n / a[:, None]
        self.area = a / 2
        self.radius = radius
        self.ex = np.zeros(len(F), bool) if excluded is None else excluded
        try:
            from scipy.spatial import cKDTree
            self.tree = cKDTree(self.C)
        except Exception:
            self.tree = None
        self.painted = {}

    def _ball(self, p, r):
        if self.tree is not None:
            return np.asarray(self.tree.query_ball_point(p, r), dtype=int)
        return np.where(np.linalg.norm(self.C - p, axis=1) < r)[0]

    def paint(self, P, d, color_key, reach=0.40):
        near = self._ball(P, reach)
        if len(near) == 0:
            return -1
        near = near[~self.ex[near]]
        if len(near) == 0:
            return -1
        v = P - self.C[near]
        facing = np.einsum('ij,ij->i', self.N[near], v) > 0
        near, v = near[facing], v[facing]
        if len(near) == 0:
            return -1
        i = near[np.argmin(np.linalg.norm(v, axis=1))]
        H, n0 = self.C[i], self.N[i]
        if np.dot(n0, P - H) < 0:
            n0 = -n0
        idx = self._ball(H, self.radius)
        if len(idx) == 0:
            return 0
        ok = (np.abs((self.C[idx] - H) @ n0) < 0.05) & (np.abs(self.N[idx] @ n0) > 0.93) & ~self.ex[idx]
        idx = idx[ok]
        new = 0
        dk = tuple(np.round(-n0, 3))
        for j in idx.tolist():
            if j not in self.painted:
                self.painted[j] = (color_key, dk)
                new += 1
        return new

    def area_painted(self):
        if not self.painted:
            return 0.0
        return float(self.area[np.fromiter(self.painted.keys(), int)].sum())

    def triangles(self, offset=0.004):
        groups = {}
        for i, (ck, dk) in self.painted.items():
            groups.setdefault(ck, []).append((i, dk))
        out = {}
        for ck, items in groups.items():
            ids = np.array([i for i, _ in items])
            dirs = np.array([dk for _, dk in items], float)
            tri = self.V[self.F[ids]].copy()
            nrm = self.N[ids].copy()
            flip = np.einsum('ij,ij->i', nrm, dirs) > 0
            nrm[flip] *= -1
            tri[flip] = tri[flip][:, [0, 2, 1], :]
            tri = tri + nrm[:, None, :] * offset
            shade = 0.62 + 0.38 * np.clip(nrm @ LIGHT, 0, 1)
            out[ck] = (tri, np.repeat(shade[:, None], 3, axis=1))
        return out


def main():
    import rclpy
    from rclpy.node import Node
    from rclpy.duration import Duration
    from rclpy.time import Time
    from std_msgs.msg import Empty, ColorRGBA
    from visualization_msgs.msg import Marker, MarkerArray
    from geometry_msgs.msg import Point
    from tf2_ros import Buffer, TransformListener

    class PaintSurface(Node):
        def __init__(self):
            super().__init__('paint_surface')
            for k, v in [('frame', 'world'), ('tip_link', 'tool0'), ('tool_offset', 0.27), ('tool_axis', 'auto'),
                         ('spray_tol', 0.05), ('paths_topic', '/painting_paths'), ('radius', 0.30),
                         ('paint_color', '0.78,0.07,0.07'), ('preview_color', '0.95,0.40,0.08'),
                         ('mesh_path', ''), ('max_edge', 0.04), ('exclude', EXCLUDE_WORDS)]:
                self.declare_parameter(k, v)
            g = lambda k: self.get_parameter(k).value
            self.frame, self.tip, self.off = g('frame'), g('tip_link'), float(g('tool_offset'))
            self.axis = None if g('tool_axis') == 'auto' else g('tool_axis')
            self.tol, self.radius, self.max_edge = float(g('spray_tol')), float(g('radius')), float(g('max_edge'))
            self.exclude = str(g('exclude'))
            rgb = lambda s: tuple(float(x) for x in str(s).split(','))
            self.paint_rgb, self.preview_rgb = rgb(g('paint_color')), rgb(g('preview_color'))
            self.mesh_path = find_mesh(g('mesh_path'))
            self.state = self.surf = None
            self.todo, self.seen = deque(), set()
            self.preview_q = deque()
            self.dirty, self.miss, self.last_j, self.prev_pos = False, 0, None, None
            self.tf_buf = Buffer()
            self.tf = TransformListener(self.tf_buf, self)
            self.pub = self.create_publisher(MarkerArray, '/paint_surface', 10)
            self.create_subscription(MarkerArray, g('paths_topic'), self.on_paths, 10)
            self.create_subscription(Empty, '/paint_reset', self.on_reset, 10)
            self.create_subscription(Empty, '/paint_preview', self.on_preview, 10)
            self.create_timer(0.05, self.tick)
            self.create_timer(0.05, self.work)
            self.create_timer(0.5, self.publish)
            self.create_timer(3.0, lambda: self.publish(force=True))
            self.create_timer(5.0, self.report)
            self.get_logger().info('car mesh file: %s' % self.mesh_path)
            self.get_logger().info('waiting for planned paths on %s ...' % g('paths_topic'))

        def on_reset(self, _):
            if self.state:
                self.state.reset()
            if self.surf:
                self.surf.painted.clear()
            self.todo.clear(); self.preview_q.clear(); self.seen.clear()
            self.last_j = self.prev_pos = None
            self.dirty = True
            self.get_logger().info('paint cleared')

        def on_preview(self, _):
            if self.state is None:
                return
            self.preview_q = deque(range(len(self.state.P)))
            self.get_logger().info('PREVIEW: painting ALL planned paths (planned coverage, not robot-executed)')

        def on_paths(self, msg):
            if self.state is not None:
                return
            pts, rgb = [], []
            for m in msg.markers:
                if m.action != Marker.ADD or len(m.points) < 2:
                    continue
                P = np.array([[p.x, p.y, p.z] for p in m.points])
                if m.type == Marker.LINE_STRIP:
                    pairs = [(i, i + 1) for i in range(len(P) - 1)]
                elif m.type == Marker.LINE_LIST:
                    pairs = [(i, i + 1) for i in range(0, len(P) - 1, 2)]
                else:
                    pairs = [(i, min(i + 1, len(P) - 1)) for i in range(len(P))]
                pts.append(densify(P, pairs, 0.02))
                rgb += [(m.color.r, m.color.g, m.color.b)] * len(pts[-1])
            if not pts:
                return
            allp = np.vstack(pts)
            if self.mesh_path is None:
                self.get_logger().error('car mesh (.dae) not found - pass -p mesh_path:=/full/path/car.dae')
                return
            try:
                V, F, EX, inside = load_car(self.mesh_path, allp, self.max_edge, self.exclude, self.get_logger().info)
            except Exception as e:
                self.get_logger().error('could not load car mesh: %s' % e)
                return
            if inside < 0.5:
                self.get_logger().warn('car mesh does not line up with the planned paths - paint may be misplaced')
            self.surf = SurfacePainter(V, F, self.radius, EX)
            self.state = PaintState(allp, rgb, spray_thr=self.tol, fixed_axis=self.axis)
            self.get_logger().info('ready: %d planned path points, painting on the real car body' % len(allp))

        def tick(self):
            if self.state is None:
                return
            try:
                t = self.tf_buf.lookup_transform(self.frame, self.tip, Time(), timeout=Duration(seconds=0.0))
            except Exception:
                return
            tr, q = t.transform.translation, t.transform.rotation
            pos = np.array([tr.x, tr.y, tr.z])
            R = quat_to_R([q.x, q.y, q.z, q.w])
            if self.prev_pos is not None and 0.01 < np.linalg.norm(pos - self.prev_pos) < 0.6:
                n = min(int(np.linalg.norm(pos - self.prev_pos) / 0.02), 15)
                for s in np.linspace(0, 1, n + 1)[1:-1]:
                    self.state.update(self.prev_pos + (pos - self.prev_pos) * s, R, self.off)
            self.state.update(pos, R, self.off)
            self.prev_pos = pos
            if len(self.state.painted) != len(self.seen):
                for j, (k, s) in sorted(self.state.painted.items()):
                    if j in self.seen:
                        continue
                    self.seen.add(j)
                    self.todo.append((j, 'robot'))
                    if self.last_j is not None and 0 < j - self.last_j <= 40:
                        for qj in range(self.last_j + 1, j):
                            if qj not in self.seen:
                                self.seen.add(qj)
                                self.todo.append((qj, 'robot'))
                    self.last_j = j

        def work(self):
            if not self.surf:
                return
            n = 0
            while self.todo and n < 40:
                j, kind = self.todo.popleft()
                if self.surf.paint(self.state.P[j], None, self.paint_rgb) < 0:
                    self.miss += 1
                self.dirty = True
                n += 1
            n = 0
            while self.preview_q and n < 60:
                j = self.preview_q.popleft()
                self.surf.paint(self.state.P[j], None, self.preview_rgb)
                self.dirty = True
                n += 1

        def publish(self, force=False):
            if self.surf is None or not (self.dirty or force):
                return
            self.dirty = False
            arr = MarkerArray()
            clear = Marker(); clear.action = Marker.DELETEALL; clear.header.frame_id = self.frame
            arr.markers.append(clear)
            for gid, (ck, (tri, shade)) in enumerate(self.surf.triangles().items()):
                m = Marker()
                m.header.frame_id = self.frame
                m.ns, m.id = 'surface_paint', gid
                m.type, m.action = Marker.TRIANGLE_LIST, Marker.ADD
                m.scale.x = m.scale.y = m.scale.z = 1.0
                m.color.r, m.color.g, m.color.b, m.color.a = ck[0], ck[1], ck[2], 1.0
                flat = tri.reshape(-1, 3)
                sh = shade.reshape(-1)
                m.points = [Point(x=float(p[0]), y=float(p[1]), z=float(p[2])) for p in flat]
                m.colors = [ColorRGBA(r=float(ck[0] * s), g=float(ck[1] * s), b=float(ck[2] * s), a=1.0) for s in sh]
                arr.markers.append(m)
            self.pub.publish(arr)

        def report(self):
            if self.surf and self.state:
                self.get_logger().info('painted %.2f m2 | planned path reached by robot: %.1f %% | misses: %d'
                                       % (self.surf.area_painted(), 100 * self.state.coverage(), self.miss))

    rclpy.init()
    node = PaintSurface()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass


if __name__ == '__main__':
    main()
