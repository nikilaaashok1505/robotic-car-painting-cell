#!/usr/bin/env python3
"""Plan (Cartesian) and execute the painting passes through MoveIt 2.

Follows the same four passes that painting_path_generator.py draws in RViz
(/painting_paths), so the robot paints exactly what you see.  Needs move_group
running (ros2 launch painting_cell_moveit_config demo.launch.py).

Example (test one pass first):
  python3 painting_executor.py --ros-args \
      -p group:=<planning group> -p tip_link:=<spray gun link> -p only:=bonnet

Parameters (all optional except group / tip_link, which must match your SRDF/URDF):
  group, tip_link, frame(world), standoff(0.0 m, use 0.0 not 0), approach(0.15 m),
  tool_axis(z | x | y | -z | -x | -y : tip-frame axis that points out of the gun),
  tool_offset(0.27 m: distance from tip_link origin to the nozzle along the tool axis -
              your spray_gun nozzle ends 0.27 m beyond tool0),
  min_fraction(0.95), step(0.01 m), joint_speed(0.6 rad/s), only("bonnet,roof"),
  results_file(~/painting_results.json)
Publishes /painted_paths (MarkerArray): each pass turns thick once it has been executed.
"""
import json
import math
import os
import time

import rclpy
from rclpy.node import Node
from rclpy.action import ActionClient
from builtin_interfaces.msg import Duration
from geometry_msgs.msg import Pose, Point
from visualization_msgs.msg import Marker, MarkerArray
from shape_msgs.msg import SolidPrimitive
from moveit_msgs.srv import GetCartesianPath, GetPositionIK
from moveit_msgs.action import MoveGroup, ExecuteTrajectory
from moveit_msgs.msg import (Constraints, PositionConstraint,
                             OrientationConstraint, BoundingVolume)


ERR = {1: 'SUCCESS', 99999: 'FAILURE', -1: 'PLANNING_FAILED', -2: 'INVALID_MOTION_PLAN',
       -3: 'MOTION_PLAN_INVALIDATED_BY_ENVIRONMENT_CHANGE', -4: 'CONTROL_FAILED', -6: 'TIMED_OUT',
       -7: 'PREEMPTED', -10: 'START_STATE_IN_COLLISION', -11: 'START_STATE_VIOLATES_PATH_CONSTRAINTS',
       -12: 'GOAL_IN_COLLISION', -13: 'GOAL_VIOLATES_PATH_CONSTRAINTS', -14: 'GOAL_CONSTRAINTS_VIOLATED',
       -15: 'INVALID_GROUP_NAME', -16: 'INVALID_GOAL_CONSTRAINTS', -17: 'INVALID_ROBOT_STATE',
       -18: 'INVALID_LINK_NAME', -21: 'FRAME_TRANSFORM_FAILURE', -22: 'COLLISION_CHECKING_UNAVAILABLE',
       -23: 'ROBOT_STATE_STALE', -26: 'START_STATE_INVALID', -27: 'GOAL_STATE_INVALID',
       -31: 'NO_IK_SOLUTION'}


def err_name(code):
    return f"{ERR.get(code, 'UNKNOWN')} ({code})"


# ----------------------------------------------------------------- path definition
# identical to painting_path_generator.py
def horizontal_passes(x0, x1, y0, y1, z, n):
    pts = []
    for i in range(n):
        y = y0 + i * (y1 - y0) / (n - 1)
        pts += [(x0, y, z), (x1, y, z)] if i % 2 == 0 else [(x1, y, z), (x0, y, z)]
    return pts


def vertical_passes_x(x0, x1, y, zb, zt, n):
    pts = []
    for i in range(n):
        x = x0 + i * (x1 - x0) / (n - 1)
        pts += [(x, y, zb), (x, y, zt)] if i % 2 == 0 else [(x, y, zt), (x, y, zb)]
    return pts


def vertical_passes_y(x, y0, y1, zb, zt, n):
    pts = []
    for i in range(n):
        y = y0 + i * (y1 - y0) / (n - 1)
        pts += [(x, y, zb), (x, y, zt)] if i % 2 == 0 else [(x, y, zt), (x, y, zb)]
    return pts


# 'normal' = outward surface normal; the gun points along -normal
PASSES = [
    dict(name='bonnet', pts=horizontal_passes(-2.05, -0.85, -0.65, 0.65, 1.03, 5),
         normal=(0.0, 0.0, 1.0), rgb=(1.0, 0.8, 0.0)),
    dict(name='roof', pts=horizontal_passes(-0.65, 0.85, -0.55, 0.55, 1.52, 5),
         normal=(0.0, 0.0, 1.0), rgb=(0.0, 0.3, 1.0)),
    dict(name='doors', pts=vertical_passes_x(-0.75, 1.35, -1.08, 0.55, 1.15, 7),
         normal=(0.0, -1.0, 0.0), rgb=(0.0, 1.0, 0.2)),
    dict(name='rear_body', pts=vertical_passes_y(2.48, -0.65, 0.65, 0.35, 1.05, 5),
         normal=(1.0, 0.0, 0.0), rgb=(1.0, 0.0, 0.0)),
]


# ----------------------------------------------------------------- pure math helpers
def cross(a, b):
    return (a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0])


def unit(v):
    n = math.sqrt(sum(c * c for c in v))
    return tuple(c / n for c in v)


def mat_to_quat(m):
    tr = m[0][0] + m[1][1] + m[2][2]
    if tr > 0:
        s = math.sqrt(tr + 1.0) * 2
        return ((m[2][1] - m[1][2]) / s, (m[0][2] - m[2][0]) / s, (m[1][0] - m[0][1]) / s, 0.25 * s)
    if m[0][0] > m[1][1] and m[0][0] > m[2][2]:
        s = math.sqrt(1.0 + m[0][0] - m[1][1] - m[2][2]) * 2
        return (0.25 * s, (m[0][1] + m[1][0]) / s, (m[0][2] + m[2][0]) / s, (m[2][1] - m[1][2]) / s)
    if m[1][1] > m[2][2]:
        s = math.sqrt(1.0 + m[1][1] - m[0][0] - m[2][2]) * 2
        return ((m[0][1] + m[1][0]) / s, 0.25 * s, (m[1][2] + m[2][1]) / s, (m[0][2] - m[2][0]) / s)
    s = math.sqrt(1.0 + m[2][2] - m[0][0] - m[1][1]) * 2
    return ((m[0][2] + m[2][0]) / s, (m[1][2] + m[2][1]) / s, 0.25 * s, (m[1][0] - m[0][1]) / s)


def frame_quat(d, tool_axis='z'):
    """Quaternion (x, y, z, w) of a tip frame whose `tool_axis` points along direction d."""
    sign = -1.0 if tool_axis.startswith('-') else 1.0
    axis = tool_axis.lstrip('-')
    d = unit(tuple(sign * c for c in d))
    ref = (1.0, 0.0, 0.0) if abs(d[0]) < 0.9 else (0.0, 1.0, 0.0)
    b = unit(cross(d, ref))
    a = cross(b, d)                         # (a, b, d) is right-handed: a x b = d
    X, Y, Z = {'z': (a, b, d), 'x': (d, a, b), 'y': (b, d, a)}[axis]
    m = [[X[0], Y[0], Z[0]], [X[1], Y[1], Z[1]], [X[2], Y[2], Z[2]]]
    return mat_to_quat(m)


def traj_time(traj):
    pts = traj.joint_trajectory.points
    if not pts:
        return 0.0
    t = pts[-1].time_from_start
    return t.sec + t.nanosec * 1e-9


def ensure_timing(traj, speed):
    """compute_cartesian_path may return un-timed points; add simple joint-speed timing if so."""
    pts = traj.joint_trajectory.points
    if len(pts) < 2 or traj_time(traj) > 1e-6:
        return False
    t, prev = 0.0, pts[0].positions
    for p in pts[1:]:
        t += max(max(abs(a - b) for a, b in zip(p.positions, prev)) / speed, 0.01)
        p.time_from_start = Duration(sec=int(t), nanosec=int((t - int(t)) * 1e9))
        p.velocities, p.accelerations = [], []
        prev = p.positions
    return True


# ----------------------------------------------------------------- node
class PaintingExecutor(Node):

    def __init__(self):
        super().__init__('painting_executor')
        for name, default in [('group', 'arm'), ('tip_link', 'tool0'), ('frame', 'world'),
                              ('standoff', 0.0), ('approach', 0.15), ('tool_axis', 'z'), ('tool_offset', 0.27),
                              ('min_fraction', 0.95), ('step', 0.01), ('joint_speed', 0.6),
                              ('only', ''), ('check_only', False),
                              ('results_file', os.path.expanduser('~/painting_results.json'))]:
            self.declare_parameter(name, default)
        g = lambda n: self.get_parameter(n).value
        self.group, self.tip, self.frame = g('group'), g('tip_link'), g('frame')
        self.standoff, self.approach, self.tool_axis = g('standoff'), g('approach'), g('tool_axis')
        self.tool_offset = g('tool_offset')
        self.min_fraction, self.step, self.joint_speed = g('min_fraction'), g('step'), g('joint_speed')
        self.check_only = g('check_only')
        self.only = [s.strip() for s in g('only').split(',') if s.strip()]
        self.results_file = g('results_file')

        self.cart = self.create_client(GetCartesianPath, '/compute_cartesian_path')
        self.ikc = self.create_client(GetPositionIK, '/compute_ik')
        self.move = ActionClient(self, MoveGroup, '/move_action')
        self.exe = ActionClient(self, ExecuteTrajectory, '/execute_trajectory')
        self.marker_pub = self.create_publisher(MarkerArray, '/painted_paths', 10)
        self.painted = MarkerArray()
        self.create_timer(1.0, lambda: self.marker_pub.publish(self.painted))

    # ---- small helpers
    def spin(self, future):
        rclpy.spin_until_future_complete(self, future)
        return future.result()

    def make_pose(self, p, d):
        q = frame_quat(d, self.tool_axis)
        off = self.tool_offset                      # tip_link origin sits `off` behind the nozzle
        pos = [p[k] - d[k] * off for k in range(3)]
        pose = Pose()
        pose.position = Point(x=float(pos[0]), y=float(pos[1]), z=float(pos[2]))
        pose.orientation.x, pose.orientation.y, pose.orientation.z, pose.orientation.w = q
        return pose

    def wait_for_servers(self):
        ok = self.cart.wait_for_service(timeout_sec=15.0)
        ok = self.ikc.wait_for_service(timeout_sec=15.0) and ok
        ok = self.move.wait_for_server(timeout_sec=15.0) and ok
        ok = self.exe.wait_for_server(timeout_sec=15.0) and ok
        return ok

    # ---- motion
    def move_to(self, pose):
        """Free-space move (MoveGroup) to a tip pose; plans, avoids collisions, executes."""
        hdr_frame = self.frame
        pc = PositionConstraint()
        pc.header.frame_id = hdr_frame
        pc.link_name = self.tip
        sphere = SolidPrimitive()
        sphere.type = SolidPrimitive.SPHERE
        sphere.dimensions = [0.005]
        pc.constraint_region = BoundingVolume(primitives=[sphere], primitive_poses=[pose])
        pc.weight = 1.0
        oc = OrientationConstraint()
        oc.header.frame_id = hdr_frame
        oc.link_name = self.tip
        oc.orientation = pose.orientation
        oc.absolute_x_axis_tolerance = oc.absolute_y_axis_tolerance = oc.absolute_z_axis_tolerance = 0.1
        oc.weight = 1.0
        goal = MoveGroup.Goal()
        goal.request.group_name = self.group
        goal.request.goal_constraints = [Constraints(position_constraints=[pc], orientation_constraints=[oc])]
        goal.request.num_planning_attempts = 10
        goal.request.allowed_planning_time = 10.0
        goal.request.max_velocity_scaling_factor = 0.3
        goal.request.max_acceleration_scaling_factor = 0.3
        goal.request.start_state.is_diff = True
        goal.planning_options.plan_only = False
        goal.planning_options.planning_scene_diff.is_diff = True
        goal.planning_options.planning_scene_diff.robot_state.is_diff = True
        gh = self.spin(self.move.send_goal_async(goal))
        if not gh.accepted:
            return False
        res = self.spin(gh.get_result_async())
        code = res.result.error_code.val
        self.last_error = err_name(code)
        if code != 1:
            self.get_logger().error(f'MoveGroup returned {self.last_error}')
        return code == 1

    def ik_check(self, pose, avoid):
        req = GetPositionIK.Request()
        req.ik_request.group_name = self.group
        req.ik_request.ik_link_name = self.tip
        req.ik_request.pose_stamped.header.frame_id = self.frame
        req.ik_request.pose_stamped.pose = pose
        req.ik_request.avoid_collisions = avoid
        req.ik_request.timeout = Duration(sec=0, nanosec=200000000)
        res = self.spin(self.ikc.call_async(req))
        return res.error_code.val

    def check(self):
        """Point-by-point IK: is every waypoint reachable (ignoring collisions) / collision-free?"""
        log = self.get_logger()
        out = []
        for ps in PASSES:
            if self.only and ps['name'] not in self.only:
                continue
            n = ps['normal']
            d = tuple(-c for c in n)
            reach = free = 0
            codes = {}
            for p in ps['pts']:
                tip = tuple(p[k] + n[k] * self.standoff for k in range(3))
                pose = self.make_pose(tip, d)
                c0 = self.ik_check(pose, False)
                c1 = self.ik_check(pose, True)
                reach += int(c0 == 1)
                free += int(c1 == 1)
                codes[err_name(c1)] = codes.get(err_name(c1), 0) + 1
            row = dict(name=ps['name'], waypoints=len(ps['pts']), ik_reachable=reach,
                       ik_collision_free=free, collision_aware_codes=codes)
            out.append(row)
            log.info(f"[{ps['name']}] waypoints={row['waypoints']}  IK reachable={reach}  "
                     f"reachable+collision-free={free}  codes={codes}")
        with open(self.results_file.replace('.json', '_ik_check.json'), 'w') as f:
            json.dump(out, f, indent=2)

    def cartesian(self, poses):
        req = GetCartesianPath.Request()
        req.header.frame_id = self.frame
        req.start_state.is_diff = True
        req.group_name = self.group
        req.link_name = self.tip
        req.waypoints = poses
        req.max_step = float(self.step)
        req.jump_threshold = 0.0
        req.avoid_collisions = True
        res = self.spin(self.cart.call_async(req))
        return res.solution, res.fraction

    def execute(self, traj):
        goal = ExecuteTrajectory.Goal()
        goal.trajectory = traj
        gh = self.spin(self.exe.send_goal_async(goal))
        if not gh.accepted:
            return False
        res = self.spin(gh.get_result_async())
        return res.result.error_code.val == 1

    def mark_painted(self, idx, ps, tips):
        m = Marker()
        m.header.frame_id = self.frame
        m.ns, m.id = 'painted', idx
        m.type, m.action = Marker.LINE_STRIP, Marker.ADD
        m.scale.x = 0.05
        m.color.r, m.color.g, m.color.b = ps['rgb']
        m.color.a = 0.9
        m.points = [Point(x=p[0], y=p[1], z=p[2]) for p in tips]
        self.painted.markers.append(m)
        self.marker_pub.publish(self.painted)

    # ---- main sequence
    def run(self):
        log = self.get_logger()
        if self.check_only:
            self.check()
            return
        results = []
        for idx, ps in enumerate(PASSES):
            if self.only and ps['name'] not in self.only:
                continue
            n = ps['normal']
            d = tuple(-c for c in n)                       # spray direction (into the surface)
            tips = [tuple(p[k] + n[k] * self.standoff for k in range(3)) for p in ps['pts']]
            app = tuple(tips[0][k] + n[k] * self.approach for k in range(3))
            length = sum(math.dist(a, b) for a, b in zip(tips[:-1], tips[1:]))
            r = dict(name=ps['name'], waypoints=len(tips), path_length_m=round(length, 3))
            results.append(r)
            log.info(f"[{ps['name']}] moving to approach pose {tuple(round(c, 2) for c in app)}")
            r['approach_ok'] = self.move_to(self.make_pose(app, d))
            if not r['approach_ok']:
                log.error(f"[{ps['name']}] approach move failed: {getattr(self, 'last_error', '?')} - skipping")
                continue
            time.sleep(0.5)
            traj, frac = self.cartesian([self.make_pose(p, d) for p in tips])
            r['cartesian_fraction'] = round(frac, 4)
            log.info(f"[{ps['name']}] Cartesian path fraction = {frac * 100:.1f} %")
            if frac < self.min_fraction:
                log.error(f"[{ps['name']}] fraction below {self.min_fraction * 100:.0f} % - not executed")
                r['executed'] = False
                continue
            ensure_timing(traj, self.joint_speed)
            r['duration_s'] = round(traj_time(traj), 2)
            r['trajectory_points'] = len(traj.joint_trajectory.points)
            r['executed'] = self.execute(traj)
            log.info(f"[{ps['name']}] execution {'SUCCEEDED' if r['executed'] else 'FAILED'} "
                     f"({r['duration_s']} s)")
            if r['executed']:
                self.mark_painted(idx, ps, tips)
                time.sleep(0.5)
                t2, f2 = self.cartesian([self.make_pose(app, d)])      # lift off the surface
                if f2 > 0.99:
                    ensure_timing(t2, self.joint_speed)
                    self.execute(t2)
        with open(self.results_file, 'w') as f:
            json.dump(dict(group=self.group, tip_link=self.tip, standoff=self.standoff, passes=results), f, indent=2)
        log.info('---- summary ----')
        for r in results:
            log.info(f"{r['name']:10s} approach={r.get('approach_ok')} "
                     f"fraction={r.get('cartesian_fraction')} executed={r.get('executed')}")
        log.info(f'results written to {self.results_file}')


def main(args=None):
    rclpy.init(args=args)
    node = PaintingExecutor()
    if not node.wait_for_servers():
        node.get_logger().error('move_group services/actions not found - is demo.launch.py running?')
    else:
        try:
            node.run()
        except KeyboardInterrupt:
            pass
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
